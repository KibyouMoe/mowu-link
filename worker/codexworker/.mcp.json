{
  "mcpServers": {
    "codexworker": {
      "command": "node",
      "cwd": ".",
      "args": [
        "./interface/desktop-mcp.mjs"
      ],
      "enabled": true,
      "default_tools_approval_mode": "approve",
      "env_vars": [
        "CODEX_APP_TOOLS_PIPE_PATH",
        "CODEX_MCP_NODE_PATH",
        "CODEX_BROWSER_USE_NODE_PATH",
        "CODEX_ELECTRON_RESOURCES_PATH",
        "XDG_CACHE_HOME",
        "HOME",
        "CODEX_HOME",
        "USERPROFILE",
        "LOCALAPPDATA",
        "PATH",
        "CODEXWORKER_STATE_DIR",
        "CODEXWORKER_NATIVE_IMAGE_INPUT",
        "CODEXWORKER_NATIVE_QUESTION_INPUT",
        "CODEXWORKER_NATIVE_INPUT_DESCRIPTOR"
      ],
      "startup_timeout_sec": 60,
      "tool_timeout_sec": 180,
      "env": { "CODEXWORKER_NATIVE_BOOTSTRAP": "1" }
    }
  }
}
