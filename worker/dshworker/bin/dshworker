#!/bin/sh
# DSHWorker launcher: resolve the real script location (following symlinks),
# then hand every argument to cli.mjs. No daemonization, no PID file.
set -eu

target=$0
while [ -L "$target" ]; do
  dir=$(CDPATH= cd -P -- "$(dirname -- "$target")" && pwd)
  link=$(readlink -- "$target")
  case $link in
    /*) target=$link ;;
    *) target=$dir/$link ;;
  esac
done
root=$(CDPATH= cd -P -- "$(dirname -- "$target")/.." && pwd)

exec "${NODE:-node}" "$root/cli.mjs" "$@"
