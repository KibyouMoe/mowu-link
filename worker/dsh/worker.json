{
  "router": "http://127.0.0.1:8790",
  "name": "dsh",
  "token_file": "~/.hermes/secrets/router.token",
  "workspace": "~/projects",
  "permission_mode": "workspace-write",
  "approval_policy": "never",
  "timeout": 3600,
  "dsh_bin": "dsh",
  "dsh_profile": "headless",
  "heartbeat_interval": 20,
  "idle_heartbeat": 60,
  "idle_reconnect": 90,
  "stall_seconds": 300,
  "feishu_creds": "~/.hermes/secrets/feishu-tsurumaru.json",
  "feishu_open_id": "",
  "subscribe": "",
  "subscribe_interval": 15,
  "log_file": "~/.hermes/logs/dsh-worker.log"
}
