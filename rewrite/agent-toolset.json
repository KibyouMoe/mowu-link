[
  {
    "name": "worker_report",
    "description": "Report completion, a blocker, or a request to continue the formal assignment on this input.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "type": "string"
        },
        "assignment_id": {
          "type": "string"
        },
        "outcome": {
          "enum": [
            "completed",
            "blocked",
            "continue_requested",
            "cancel_confirmed",
            "transfer_confirmed"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "artifact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "task_id",
        "assignment_id",
        "summary"
      ]
    }
  },
  {
    "name": "worker_ask",
    "description": "Ask the manager a question about this formal assignment.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "label"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "text",
        "options"
      ]
    }
  },
  {
    "name": "worker_send_peer",
    "description": "Send a private message to a named Worker or reply to their original message. A pending response contains the message ID for later status checks. This does not create or complete a formal assignment.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "to_worker": {"type": "string", "minLength": 1},
        "text": {"type": "string"},
        "reply_to": {"type": "string", "minLength": 1},
        "attachment_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "attachment_kinds": {"type": "array", "items": {"enum": ["image", "file"]}}
      },
      "required": ["to_worker"]
    }
  },
  {
    "name": "worker_peer_status",
    "description": "Check Router intake, the recipient Worker inbox and the native host receipt for a private message you sent or received.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "message_id": {"type": "string", "minLength": 1}
      },
      "required": ["message_id"]
    }
  },
  {
    "name": "worker_submit_material",
    "description": "Submit separate candidate material for this earlier assignment while the task is still in the blocked pool. Receipt only records the material. It does not complete the task or change its holder.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "assignment_id": {"type": "string", "minLength": 1},
        "text": {"type": "string"},
        "artifact_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "required": ["task_id", "assignment_id"]
    }
  }
]
